---
import '@fontsource-variable/manrope';
import '@fontsource-variable/fraunces/wght-italic.css';
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import { org, nav } from '../data/site';

interface Props { title: string; description: string; jsonLd?: object }
const { title, description, jsonLd } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" href="/img/favicon.png" />
  <meta name="theme-color" content="#1f5560" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL('/img/og.jpg', Astro.site)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta property="og:locale" content="it_IT" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a class="skip" href="#main">Vai al contenuto</a>

  <header class="header">
    <div class="wrap header-in">
      <a href="/" class="logo"><img src="/img/logo.png" alt="Comunità Lautari – Il tuo futuro è insieme" width="154" height="33" /></a>
      <nav class="nav" aria-label="Principale">
        {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <a class="header-phone" href={org.phoneHref}>{org.phone}</a>
      <a class="btn btn-accent" href="/sostienici">Sostienici</a>
      <details class="menu">
        <summary aria-label="Apri menu"><span></span></summary>
        <nav aria-label="Menu mobile">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          <a href="/progetti">Progetti</a>
          <a href="/sostienici">Sostienici</a>
          <a href={org.phoneHref} class="btn btn-primary">Chiama {org.phone}</a>
        </nav>
      </details>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="footer">
    <div class="wrap footer-cta">
      <h2>Non devi affrontarlo <em>da solo.</em></h2>
      <div class="footer-cta-actions">
        <a class="btn btn-accent btn-lg" href={org.phoneHref}>Chiama {org.phone}</a>
        <a class="btn btn-ghost btn-lg" href={`mailto:${org.email}`}>Scrivici</a>
      </div>
    </div>
    <div class="wrap footer-grid">
      <div>
        <img src="/img/logo.png" alt="Comunità Lautari" width="154" height="33" class="footer-logo" />
        <p>Comunità terapeutica per la riabilitazione di persone dipendenti da alcol e droghe, dal {org.founded}. La permanenza è gratuita.</p>
        <p><a href={org.phoneHref}>{org.phone}</a><br /><a href={`mailto:${org.email}`}>{org.email}</a><br />Via Monte Ingrana, 2 – 25010 Pozzolengo (BS)</p>
      </div>
      <div>
        <h2>Aiuto</h2>
        <a href="/chiedi-aiuto">Chiedi aiuto</a>
        <a href="/chiedi-aiuto#famiglie">Per le famiglie</a>
        <a href="/faq">Domande frequenti</a>
        <a href="/percorso">Il percorso</a>
      </div>
      <div>
        <h2>Comunità</h2>
        <a href="/chi-siamo">Chi siamo</a>
        <a href="/progetti">Progetti di prevenzione</a>
        <a href="/sedi">Sedi e contatti</a>
        <a href="/chi-siamo#trasparenza">Trasparenza e bilanci</a>
      </div>
      <div>
        <h2>Sostieni</h2>
        <a href="/sostienici">Dona ora</a>
        <a href="/sostienici#aziende">Per le aziende</a>
        <a href="/sostienici#cinque-per-mille">5×1000 – CF {org.cf}</a>
        <a href={org.facebook} rel="noopener">Facebook</a>
      </div>
    </div>
    <div class="wrap footer-legal">
      <p>© {year} {org.legalName} · Sede legale Via Monte Ingrana 2, 25010 Pozzolengo (BS) · CF e P.IVA {org.cf} · {org.rea} · {org.albo} · <a href="/privacy">Privacy e cookie policy</a> · <button type="button" class="linkish" data-cookie-prefs>Preferenze cookie</button></p>
      <p class="footer-aid"><strong>Aiuti di stato:</strong> la COOP. SOC.LE DI SOLIDAR. LAUTARI ONLUS partecipa al Programma Nazionale Inclusione e Lotta alla povertà 2021-2027, Priorità 3 “Contrasto alla deprivazione materiale”, Obiettivo Specifico ESO.4.13, Azione di contrasto alla povertà alimentare (PN Inclusione), in qualità di Organizzazione partner Territoriale associata all’Organizzazione partner Capofila Banco Alimentare della Lombardia “Danilo Fossati” ODV. Nell’anno 2025 ha sostenuto 110 persone in condizione di grave deprivazione attraverso aiuti alimentari e misure di accompagnamento: 3.224 kg di prodotti alimentari distribuiti, 96.030 pacchi e/o pasti finanziati dal PN Inclusione.</p>
    </div>
  </footer>

  <CookieBanner />

  <aside aria-label="Contatto rapido"><a class="call-orb" href={org.phoneHref} aria-label="Chiama ora · 030 9918700">
    <svg viewBox="0 0 100 100" aria-hidden="true"><defs><path id="orb-path" d="M50 50m-38 0a38 38 0 1 1 76 0a38 38 0 1 1-76 0" /></defs><text><textPath href="#orb-path" textLength="236">CHIAMA ORA · 030 9918700 · </textPath></text></svg>
    <i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg></i>
  </a></aside>

  <nav class="mobile-bar" aria-label="Azioni rapide">
    <a href={org.phoneHref} class="btn btn-primary">Chiama ora</a>
    <a href="/sostienici" class="btn btn-accent">Dona</a>
  </nav>

  <script>
    // Pulsanti "copia" (IBAN, codice fiscale...). L'API clipboard esiste solo in https:
    // in http si ripiega sul vecchio metodo con una textarea temporanea.
    const copy = async (text: string) => {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        const ta = Object.assign(document.createElement('textarea'), { value: text, readOnly: true });
        ta.style.cssText = 'position:fixed;opacity:0';
        document.body.append(ta);
        ta.select();
        const ok = document.execCommand('copy');
        ta.remove();
        return ok;
      }
    };
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
      b.addEventListener('click', async () => {
        const t = b.textContent;
        b.textContent = (await copy(b.dataset.copy!)) ? 'Copiato ✓' : 'Seleziona e copia';
        setTimeout(() => (b.textContent = t), 1800);
      })
    );

    // Numeri che contano da 0 quando entrano nello schermo (fermi con "riduci movimento").
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver((entries) => entries.forEach(({ isIntersecting, target }) => {
        if (!isIntersecting) return;
        io.unobserve(target);
        const el = target as HTMLElement, end = Number(el.dataset.count), t0 = performance.now();
        const tick = (t: number) => {
          const k = Math.min(1, (t - t0) / 1400);
          el.textContent = String(Math.round(end * (1 - (1 - k) ** 3)));
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }), { threshold: 0.6 });
      document.querySelectorAll('[data-count]').forEach((el) => io.observe(el));
    }
  </script>
</body>
</html>
